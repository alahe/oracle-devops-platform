# Local Development & Enterprise Configuration (.env.example)
# Copy this file to .env before starting containers

# ============================================================================
# ACTIVE DATABASE PROFILES
# Define container instances by mapping <NAME>_DB=<profile-name>, DB_<NAME>=<profile-name>,
# or <NAME>_PROXY=<profile-name> (e.g., PUB_DB, DB_PROXY, ords_proxy, DB_BIZAPP).
# Profile files must exist in config/profiles/databases/<profile-name>.yaml.
#
# Available Database Profiles (in config/profiles/databases/*.yaml):
#   - proxy-adb-oracle        (APEX Outbound Proxy ADB - Oracle Registry)
#   - proxy-standard-oracle   (APEX Outbound Proxy Standard - Oracle Registry)
#   - proxy-standard-gvenzl   (APEX Outbound Proxy Standard - Gvenzl Docker Hub)
#   - proxy-standalone-ords   (APEX Outbound Proxy - Dedicated Standalone Podman ORDS on port 8085)
#   - proxy-external-ords     (APEX Outbound Proxy - External Corporate ORDS Server)
#   - bizapp-standard-oracle  (Business Application DB Standard)
#   - bizapp-adb-oracle       (Business Application DB Autonomous)
#   - appinfra-standard-gvenzl(Application Infrastructure DB Standard)
#   - cicd-standard-oracle    (CI/CD Pipeline Testing DB)
# ============================================================================

# Primary APEX Outbound Proxy / Publisher Database Configurations
PUB_DB=bizapp-standard-oracle
# DB_PROXY=proxy-adb-oracle
# DB_DEV=proxy-standard-gvenzl
# ords_proxy=proxy-standalone-ords
# ords_external=proxy-external-ords

# Additional Database Containers (Container name is derived 1:1 from key, e.g., DB_LIS -> db-lis):
# If container name repeats, an incremental suffix (-2, -3) is added automatically for uniqueness.
# DB_PUBLISHER=appinfra-standard-gvenzl
# DB_LIS=proxy-standard-gvenzl
# DB_BIZAPP=bizapp-standard-oracle
# DB_CICD=cicd-standard-oracle

# ============================================================================
# WEB IDE SERVICE PROFILE & ARTIFACTORY MIRROR REGISTRY
# Available profiles (in config/profiles/web-ide/*.yaml):
#   - web-ide-standard         (Browser VS Code + SQL Developer + Liquibase + Tools)
#   - web-ide-artifactory-vsix (Standard VS Code + Enterprise VSIX extension packages)
#   - web-ide-minimal          (Minimal VS Code without extra tools)
#   - web-ide-disabled         (Web IDE container disabled)
# ============================================================================

WEB_IDE_PROFILE=web-ide-standard

# Enterprise Artifactory Mirror Registry Example:
# ARTIFACTORY_DOCKER_REGISTRY=artifactory.corp.internal
