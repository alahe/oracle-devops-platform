# ==============================================================================
# Oracle DevOps Platform - Enterprise Multi-Host Inventory (PROD)
# Environment: Production (PROD) with Dual-Datacenter Active / Standby
# ==============================================================================
ENVIRONMENT_NAME="PROD"
BASTION_HOST="bastion.prod.corp.bank"
SSH_USER="opc"
SSH_KEY_PATH="${HOME}/.ssh/id_ed25519"

# Ingress / Enterprise VIP
VIP_FQDN="devops-prod.corp.bank"
VIP_ORDS_PORT="443"
VIP_PUBLISHER_PORT="9502"

# ------------------------------------------------------------------------------
# DATACENTER 1 (ACTIVE NODES)
# ------------------------------------------------------------------------------
ORDS_HOST="ords-prod-dc1.corp.bank"
ORDS_HTTPS_PORT="8448"
ORDS_HTTP_PORT="8088"

PUBLISHER_HOST="publisher-prod-dc1.corp.bank"
PUBLISHER_HTTPS_PORT="9502"
PUBLISHER_HTTP_PORT="9500"

PROXY_DB_HOST="proxy-db-prod-dc1.corp.bank"
PROXY_DB_PORT="1533"
PROXY_DB_SERVICE="FREEPDB1"

PUBLISHER_DB_HOST="publisher-db-prod-dc1.corp.bank"
PUBLISHER_DB_PORT="1532"
PUBLISHER_DB_SERVICE="FREEPDB1"

# ------------------------------------------------------------------------------
# DATACENTER 2 (STANDBY NODES)
# ------------------------------------------------------------------------------
STANDBY_ORDS_HOST="ords-prod-dc2.corp.bank"
STANDBY_PUBLISHER_HOST="publisher-prod-dc2.corp.bank"
STANDBY_PROXY_DB_HOST="proxy-db-prod-dc2.corp.bank"
STANDBY_PUBLISHER_DB_HOST="publisher-db-prod-dc2.corp.bank"

# Synchronization Settings
STANDBY_SYNC_INTERVAL_MINUTES="15"
STANDBY_SNAPSHOT_DIR="/var/lib/oracle-snapshots"

# External Core Business Database (Existing Enterprise RAC / Exadata)
BIZ_DB_HOST="bizdb-scan.corp.bank"
BIZ_DB_PORT="2484"
BIZ_DB_SERVICE="BIZ_PROD.CORP.BANK"
BIZ_DB_PROTOCOL="TCPS"
BIZ_DB_SSL_SERVER_CERT_DN="CN=bizdb-scan.corp.bank,OU=IT,O=Bank,C=EE"
