# ==============================================================================
# Git Attributes Configuration - Line Endings & Cross-Platform Portability
# Enforces LF line endings for all scripts and code files across all OSes.
# ==============================================================================

# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Shell scripts - strictly LF (prevents /bin/bash^M bad interpreter on Windows/WSL)
*.sh text eol=lf

# Windows scripts - strictly CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Database and configuration files - strictly LF
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.env* text eol=lf
*.apx text eol=lf

# Documentation
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.tar.gz binary
*.zip binary
*.p12 binary
*.sso binary
*.png binary
*.jpg binary
*.ico binary
*.der binary
