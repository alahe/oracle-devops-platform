<?xml version="1.0" encoding="UTF-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.0" defaultDataSourceRef="ALISE_APP_DB">
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="Q_INVOICE" type="complex">
      <sql dataSourceRef="ALISE_APP_DB">
        <![CDATA[
SELECT 
    'Eesti Pilveplatvorm OÜ'                                     AS company_name,
    '12345678'                                                  AS reg_code,
    'EE101234567'                                               AS vat_number,
    'Lõõtsa tn 8a, 11415 Tallinn, Eesti'                        AS address,
    'arved@pilveplatvorm.ee'                                    AS email,
    '+372 600 1234'                                             AS phone,
    'EE009900000000000000'                                      AS iban,
    'BANKEE2X'                                                  AS swift,
    'Näidispank AS'                                             AS bank_name,
    'EE-2026-8941'                                              AS invoice_num,
    '2026-09-02'                                                AS invoice_date,
    '2026-09-16'                                                AS due_date,
    '14 päeva'                                                  AS payment_terms,
    'EUR'                                                       AS currency,
    '202689418'                                                 AS payment_reference,
    'Täname meeldiva koostöö eest! Arve tasumisel märkida viitenumber.' AS notes,
    'Nordic Innovation AS'                                      AS cust_name,
    '87654321'                                                  AS cust_reg_code,
    'EE109876543'                                               AS cust_vat_number,
    'Narva mnt 5, 10117 Tallinn, Eesti'                         AS cust_address,
    'Jaan Tamm'                                                 AS cust_contact_person,
    3000.00                                                     AS subtotal,
    '22%'                                                       AS vat_rate,
    660.00                                                      AS vat_amount,
    3660.00                                                     AS grand_total,
    lines.line_num                                              AS line_num,
    lines.item_desc                                             AS item_desc,
    lines.qty                                                   AS qty,
    lines.unit                                                  AS unit,
    lines.unit_price                                            AS unit_price,
    lines.line_total                                            AS line_total
FROM DUAL
CROSS JOIN (
    SELECT 1 AS line_num, 'Oracle 23ai Konteinerite DevOps Platvormi Konsultatsioon' AS item_desc, 16.00 AS qty, 'h' AS unit, 95.00 AS unit_price, 1520.00 AS line_total FROM DUAL
    UNION ALL
    SELECT 2, 'Oracle APEX 26.1 and APEXlang DSL Automaatika Seadistus', 8.00, 'h', 110.00, 880.00 FROM DUAL
    UNION ALL
    SELECT 3, 'Analytics Publisher Pixel-Perfect Trükiste Mallide Kujundus', 1.00, 'tk', 600.00, 600.00 FROM DUAL
) lines
        ]]>
      </sql>
    </dataSet>
  </dataSets>
  <output rootName="INVOICE_DATA">
    <nodeList name="data-structure">
      <dataStructure>
        <group name="HEADER" source="Q_INVOICE">
          <element name="COMPANY_NAME" value="company_name"/>
          <element name="REG_CODE" value="reg_code"/>
          <element name="VAT_NUMBER" value="vat_number"/>
          <element name="ADDRESS" value="address"/>
          <element name="EMAIL" value="email"/>
          <element name="PHONE" value="phone"/>
          <element name="BANK_NAME" value="bank_name"/>
          <element name="IBAN" value="iban"/>
          <element name="SWIFT" value="swift"/>
          <group name="INVOICE" source="Q_INVOICE">
            <element name="INVOICE_NUM" value="invoice_num"/>
            <element name="INVOICE_DATE" value="invoice_date"/>
            <element name="DUE_DATE" value="due_date"/>
            <element name="PAYMENT_TERMS" value="payment_terms"/>
            <element name="CURRENCY" value="currency"/>
            <element name="PAYMENT_REFERENCE" value="payment_reference"/>
            <element name="NOTES" value="notes"/>
            <group name="CUSTOMER" source="Q_INVOICE">
              <element name="NAME" value="cust_name"/>
              <element name="REG_CODE" value="cust_reg_code"/>
              <element name="VAT_NUMBER" value="cust_vat_number"/>
              <element name="ADDRESS" value="cust_address"/>
              <element name="CONTACT_PERSON" value="cust_contact_person"/>
            </group>
            <group name="G_LINES" source="Q_INVOICE">
              <element name="LINE_NUM" value="line_num"/>
              <element name="ITEM_DESC" value="item_desc"/>
              <element name="QTY" value="qty"/>
              <element name="UNIT" value="unit"/>
              <element name="UNIT_PRICE" value="unit_price"/>
              <element name="LINE_TOTAL" value="line_total"/>
            </group>
            <group name="TOTALS" source="Q_INVOICE">
              <element name="SUBTOTAL" value="subtotal"/>
              <element name="VAT_RATE" value="vat_rate"/>
              <element name="VAT_AMOUNT" value="vat_amount"/>
              <element name="GRAND_TOTAL" value="grand_total"/>
            </group>
          </group>
        </group>
      </dataStructure>
    </nodeList>
  </output>
</dataModel>
